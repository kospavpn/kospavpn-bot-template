# === Telegram ===
BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789
CHANNEL_USERNAME=your_channel

# === X-UI Panel ===
XUI_HOST=https://your-panel-host:port/secret_path
XUI_TOKEN=your_xui_bearer_token
SUBSCRIPTION_HOST=https://your-server.com:port
SUBSCRIPTION_PATH=/your-config-path/

# === Platega Payment ===
PLATEGA_MERCHANT_ID=your_merchant_id
PLATEGA_SECRET_KEY=your_secret_key
BOT_RETURN_URL=https://t.me/your_bot

# === Coinso Payment ===
COINSO_SECRET_KEY=your_coinso_secret_key
COINSO_PROJECT_ID=123456789

# === SSL (for webhook server) ===
SSL_CERT_PATH=/path/to/fullchain.pem
SSL_KEY_PATH=/path/to/privkey.pem
WEBHOOK_PORT=8443
